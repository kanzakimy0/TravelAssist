# Copy this file to .env.local when local environment variables are needed.
# Never commit real API keys, passwords, tokens, or secrets.

# Optional public browser token; restrict allowed URLs in the Mapbox account.
# Leave empty for the fully interactive schematic fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Database foundation: local values only during TASK-009; never commit secrets.
# SDK 2.x / CLI 2.116 use publishable + secret keys (not a second anon-key alias).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Privileged service-role access, server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Future integrations may require variables in these categories. Providers and
# final variable names will be selected in later tasks.
# NEXT_PUBLIC_MAP_...
# AI_API_...
