# Copy this file to .env.local when local environment variables are needed.
# Never commit real API keys, passwords, tokens, or secrets.

# TASK-025: application environment is independent from NODE_ENV.
# Preview and production targets remain disabled until their exact origins,
# resource IDs and deployment permissions are approved in repository policy.
APP_ENV=
DEPLOYMENT_TARGET_ID=
DEPLOYMENT_COMMIT_SHA=
DATABASE_TARGET=
AUTH_PROVIDER_MODE=
MAP_PROVIDER_MODE=
OBSERVABILITY_EXPORT_MODE=disabled
OBSERVABILITY_TARGET_ID=

# Optional public browser token; restrict allowed URLs in the Mapbox account.
# Leave empty for the fully interactive schematic fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# TASK-015: placeholders only. Configure locally; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never expose these using a NEXT_PUBLIC_ alias.
SUPABASE_URL=
# TASK-052: runtime-only current-account hard delete; missing/invalid fails closed.
SUPABASE_SECRET_KEY=
DATABASE_URL=
SUPABASE_PROJECT_REF=

# TASK-018: canonical application origin (e.g. local http://127.0.0.1:3000).
# Runtime-only; never infer OAuth/recovery callback origins from request headers.
AUTH_SITE_URL=

# TASK-022: server-only Ekiworld routing placeholders.
# Evaluation mode is development-only. Production requires explicit approved entitlement.
ROUTING_PROVIDER_MODE=
EKIWORLD_ACCESS_KEY=
ROUTING_EKIWORLD_PRODUCTION_APPROVED=
# TASK-023: explicit server-side gate for authenticated local Evaluation preview.
# Evaluation remains denied in production and preview deployments.
ROUTING_PLANNER_QUERY_ENABLED=

# Future integrations may require variables in these categories. Providers and
# final variable names will be selected in later tasks.
# NEXT_PUBLIC_MAP_...
# AI_API_...
# DATABASE_...
# AUTH_...

# TASK-076: server-only OpenAI Responses API runtime. Leave empty unless an
# authorized local credential/model is configured. Never use NEXT_PUBLIC_ aliases.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional bounded policy: timeout 1000..60000 ms; retries 0..2.
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=1
